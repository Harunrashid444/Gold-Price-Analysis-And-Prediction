# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/gold_price_analysis

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Optional: allow the API to run without MongoDB (users stored in memory)
# Set to true only for local demo if MongoDB is not installed.
MEMORY_DB=false

# Password-reset email provider — pending. Leave SMTP_HOST empty to keep reset
# tokens logged to the server console instead of sending email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost
RESET_TOKEN_HOURS=1
